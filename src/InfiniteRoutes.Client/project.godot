; Engine configuration file.
; Edit through the Godot editor (Project → Project Settings) where possible.

config_version=5

[application]

config/name="Pokémon: Infinite Routes"
config/description="Online Pokémon MMO built on the player's own DS games."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/min_width=960
window/size/min_height=600

[dotnet]

project/assembly_name="InfiniteRoutes.Client"
